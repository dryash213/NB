{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GoogleAdsResponsiveSearchAdOperation",
  "description": "Google Ads API REST v17 AdGroupAd:mutate payload for Responsive Search Ads (RSA)",
  "type": "object",
  "required": ["operations"],
  "properties": {
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["create"],
        "properties": {
          "create": {
            "type": "object",
            "required": ["status", "adGroup", "ad"],
            "properties": {
              "status": { "type": "string", "enum": ["PAUSED", "ENABLED"] },
              "adGroup": { "type": "string", "pattern": "^customers/[0-9]+/adGroups/[0-9]+$" },
              "ad": {
                "type": "object",
                "required": ["finalUrls", "responsiveSearchAd"],
                "properties": {
                  "finalUrls": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "format": "uri" }
                  },
                  "responsiveSearchAd": {
                    "type": "object",
                    "required": ["headlines", "descriptions"],
                    "properties": {
                      "headlines": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 15,
                        "items": {
                          "type": "object",
                          "required": ["text"],
                          "properties": {
                            "text": { "type": "string", "maxLength": 30 },
                            "pinnedField": {
                              "type": "string",
                              "enum": ["HEADLINE_1", "HEADLINE_2", "HEADLINE_3"]
                            }
                          }
                        }
                      },
                      "descriptions": {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 4,
                        "items": {
                          "type": "object",
                          "required": ["text"],
                          "properties": {
                            "text": { "type": "string", "maxLength": 90 },
                            "pinnedField": {
                              "type": "string",
                              "enum": ["DESCRIPTION_1", "DESCRIPTION_2"]
                            }
                          }
                        }
                      },
                      "path1": { "type": "string", "maxLength": 15 },
                      "path2": { "type": "string", "maxLength": 15 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

